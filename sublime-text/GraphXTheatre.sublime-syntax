%YAML 1.2
---
name: GraphXTheatre
file_extensions:
  - gt
  # - graphxtheatre
  # - theatre
scope: source.gt

contexts:
  main:
    - match: ^(@\w+)\n?([^\S\r\n]+\w+|[^\S\r\n]+)?
      captures:
        1: support.constant
        2: invalid.illegal.no-whitespace
    - match: '[\w\d]+(?=\s)'
      scope: storage.type.class
    - match: '//.+'
      scope: comment.line
    - match: '\('
      scope: punctuation.bracket.round
      push: raw_data
    - match: '{'
      scope: punctuation.bracket.curly
      push: inside_object

  inside_object:
    - match: '\['
      scope: punctuation.bracket.square
      push: cpp_reference
    - match: '\('
      scope: punctuation.bracket.round
      push: raw_data
    - match: '\<'
      scope: punctuation.bracket.angle
      push: theatre_reference
    - match: '^\s+'
      push: variable_name
    - match: '}'
      scope: punctuation.bracket.curly
      pop: true

  variable_name:
    - match: '[a-zA-Z_]+'
      scope: variable.other.member
    - match: ':'
      scope: punctuation.delimiter
    - match: '\s'
      pop: true

  cpp_reference:
    - match: '[\w\d]+'
      scope: constant.other.class
    - match: '\]'
      pop: true
    - match: .
      scope: invalid.illegal

  raw_data:
    - match: '([a-zA-Z])?(?(1)(.*(?=\)))|((?<![\w_:;"\/\\])(-)?([0-9]+)(\.?)((,)?(?(8)\s+|((?:[^\S\d\)]?)+(?:[a-zA-Z_\.]?)+)))))'
      captures:
        1: string.quoted
        2: string.quoted
        4: punctuation.separator.dash
        5: constant.numeric
        6: punctuation.delimiter.decimal.period
        8: punctuation.separator.comma
        9: invalid.illegal.character
    - match: '\)'
      scope: punctuation.bracket.round
      pop: true


  theatre_reference:
    - match: '[\w\d]+'
      scope: entity.name.class
    - match: '>'
      scope: punctuation.bracket.angle
      pop: true
