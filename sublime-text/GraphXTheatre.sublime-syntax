%YAML 1.2
---
name: GraphXTheatre
file_extensions:
  - gt
  # - graphxtheatre
  # - theatre
scope: source.gt

contexts:
  main:
    - match: ^(@\w+)\n?([^\S\r\n]+\w+|[^\S\r\n]+)?
      captures:
        1: support.constant
        2: invalid.illegal.no-whitespace
    - match: '//.+'
      scope: comment.line
    - match: '\('
      scope: punctuation.bracket.round
      push: raw_data
    - match: '{'
      scope: punctuation.bracket.curly
      push: inside_object

  inside_object:
    - match: ':'
      scope: punctuation.delimiter
    - match: '\['
      scope: punctuation.bracket.square
      push: cpp_reference
    - match: '\('
      scope: punctuation.bracket.round
      push: raw_data
    - match: '\<'
      scope: punctuation.bracket.angle
      push: theatre_reference
    - match: \b(\w+)\b
      scope: variable
    - match: '}'
      scope: punctuation.bracket.curly
      pop: true
    - include: main

  cpp_reference:
    - match: '[\w\d]+'
      scope: punctuation.bracket.square
    - match: '\]'
      pop: true
    - match: .
      scope: invalid.illegal

  raw_data:
    # - match: '(((?<![^\W\(,]\s)((-?)\b([0-9]+(\.?))+\b)((,)(\s+)?)?)|((?<=[\(])(\w?+\d?+\s?+)+))+'
    # - match: '(((?<![^\W\(,]\s)(-)?\b(\d+)(\.)?\b(,)?(\s+)?)|((?<=[\(])(\w?+\d?+\s?+)+))+'
    # - match: '([^\sA-Za-z_:;-]\K((-?)(((\d+)(\.)?)+)(\,)?(?:\s+)?)+|((\w?+\d?+\s?+)+)+)'
      captures:
        3: punctuation.separator.dash
        4: constant.numeric
        7: punctuation.delimiter.decimal.period
        8: punctuation.separator.comma
        8: string.quoted
    - match: '\)'
      scope: punctuation.bracket.round
      pop: true


  theatre_reference:
    - include: main